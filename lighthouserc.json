{
  "ci": {
    "collect": {
      "url": [
        "https://nextjs-dashoard-psi.vercel.app/",
        "https://nextjs-dashoard-psi.vercel.app/clinic-login",
        "https://nextjs-dashoard-psi.vercel.app/login",
        "https://nextjs-dashoard-psi.vercel.app/medical-aid"
      ],
      "numberOfRuns": 2,
      "settings": {
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "assertions": {
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "categories:performance": ["warn", { "minScore": 0.6 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": "lighthouse-report" }
  }
}
